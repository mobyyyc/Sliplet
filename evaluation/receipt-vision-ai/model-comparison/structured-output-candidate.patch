diff --git a/SlipletTests/ReceiptUploadTests.swift b/SlipletTests/ReceiptUploadTests.swift
index c2761e5..225cb30 100644
--- a/SlipletTests/ReceiptUploadTests.swift
+++ b/SlipletTests/ReceiptUploadTests.swift
@@ -107,6 +107,21 @@ private struct UploadTester: ReceiptAIConnectionTesting {
         XCTAssertFalse(request.url!.absoluteString.contains("FICTIONAL_KEY"))
         let object = try JSONSerialization.jsonObject(with: request.httpBody!) as! [String: Any]
         let parts = ((object["contents"] as! [[String: Any]])[0]["parts"] as! [[String: Any]])
+        let config = try XCTUnwrap(object["generationConfig"] as? [String: Any])
+        XCTAssertEqual(config["responseMimeType"] as? String, "application/json")
+        let schema = try XCTUnwrap(config["responseSchema"] as? [String: Any])
+        XCTAssertEqual(Set(schema["required"] as! [String]), ReceiptModelAdapter.rootKeys)
+        XCTAssertNil(schema["additionalProperties"])
+        let properties = schema["properties"] as! [String: Any]
+        let merchant = properties["merchant"] as! [String: Any]
+        XCTAssertEqual(merchant["type"] as? String, "string")
+        XCTAssertEqual(merchant["nullable"] as? Bool, true)
+        let rows = properties["rows"] as! [String: Any]
+        let row = rows["items"] as! [String: Any]
+        XCTAssertEqual(Set(row["required"] as! [String]), ReceiptModelAdapter.rowKeys)
+        XCTAssertNil(row["additionalProperties"])
+        XCTAssertEqual(rows["maxItems"] as? Int, 150)
+        XCTAssertEqual(config["maxOutputTokens"] as? Int, 6500)
         XCTAssertEqual(parts.count, 2)
         let inline = parts[0]["inlineData"] as! [String: String]
         XCTAssertEqual(Data(base64Encoded: inline["data"]!), upload.bytes)
